{
  "expo": {
    "name": "MoneyBot",
    "slug": "moneybot",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "moneybot",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moneybot.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.153959048568-ji63jtsd7eo4e6u1bpn7743t34l15hu0"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.moneybot.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://moneybotmobile-production.up.railway.app/api",
      "eas": {
        "projectId": "fe4bcf28-9507-4f0c-9fdf-1f8196fecf4f"
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-asset",
      "expo-splash-screen",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#3DDC5F"
        }
      ]
    ]
  }
}
