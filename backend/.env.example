# Copy this file to .env and fill in real values. .env is gitignored.
# Never put a real API key in this file - it is committed to git.

# OpenAI (required for the Tutor and Money Chat AI features)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Django (optional overrides; sensible dev defaults are used if omitted)
DJANGO_SECRET_KEY=django-insecure-moneybot-dev-secret-change-in-production
DJANGO_DEBUG=True

# Production hosting (only needed when DJANGO_DEBUG=False):
# Comma-separated hostnames Django will serve.
DJANGO_ALLOWED_HOSTS=getmoneybot.com,api.getmoneybot.com
# Extra browser origins allowed to call the API (the panel is same-origin, so
# usually only needed if you host the panel on a different domain).
DJANGO_CORS_ORIGINS=https://getmoneybot.com
# Origins trusted for CSRF (include scheme), typically your panel domain.
DJANGO_CSRF_TRUSTED_ORIGINS=https://getmoneybot.com
# Optional Postgres DSN. If unset, SQLite (db.sqlite3) is used.
# Requires psycopg installed: pip install "psycopg[binary]"
DATABASE_URL=postgres://user:password@localhost:5432/moneybot

# Google Sign-In (required for "Continue with Google").
# Comma-separated list of every OAuth client ID the mobile app may use:
# the Web client ID, the iOS client ID, and the Android client ID.
# Get these from Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com

# Sign in with Apple (iOS). Usually your iOS bundle ID.
APPLE_CLIENT_IDS=com.moneybot.app
